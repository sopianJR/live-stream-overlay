{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveStream Overlay",
  "version": "0.1.0",
  "identifier": "com.livestreamapps.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveStream Overlay — Dashboard",
        "url": "index.html",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "LiveStreamApps",
    "category": "Utility",
    "shortDescription": "Overlay live chat YouTube & status OBS untuk streamer satu monitor",
    "longDescription": "Menampilkan live chat YouTube, status OBS, dan alert masalah stream sebagai overlay transparan di atas game. Overlay tembus klik, tidak mencuri fokus, dan tidak ikut tertangkap di stream.",
    "copyright": "Prototype LiveStreamApps",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
